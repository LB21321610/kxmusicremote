# Example only; this file is NOT loaded automatically. Set Windows environment
# variables in the same PowerShell process that starts the remote, or save them
# as Windows user environment variables for the desktop launcher (restart remote).
# Local Ollama only; these defaults work without setting any environment variable.
HY_MT2_URL=http://127.0.0.1:11434
HY_MT2_MODEL=hy-mt2-translate
# Apple Music catalog (search, album/artist pages): storefront and page language.
REMOTE_CATALOG_STOREFRONT=us
REMOTE_CATALOG_LANGUAGE=zh-Hans-CN
